PORT=3000
ADMIN_API_KEY=change-this-admin-key

# Discord bot (required for auto DM delivery)
DISCORD_BOT_TOKEN=
STAFF_LOG_CHANNEL_ID=
LIVE_STOCK_CHANNEL_ID=

# Product catalog and payment instructions for Discord Buy panel (JSON strings)
CATALOG_JSON=[{"sku":"rdp-basic","label":"RDP Basic","price":10,"currency":"USD"}]
PAYMENT_METHOD_INSTRUCTIONS_JSON={"paypal":"Pay using your PayPal checkout link.","gcash":"Pay to your GCash number and save the reference."}
AUTO_FULFILL_ON_PROOF=false

# Auto advertisement in buy/sell channel
AUTO_AD_ENABLED=false
AUTO_AD_CHANNEL_ID=
AUTO_AD_CHANNEL_IDS=
AUTO_AD_INTERVAL_MINUTES=60
AUTO_AD_MESSAGE=RDP STOCK AVAILABLE. DM OR CLICK BUY PANEL TO ORDER.
AUTO_AD_MENTION_ROLE_ID=

# PayPal webhook verification (required for real PayPal auto-delivery)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Optional shared secret for GCash/manual wallet gateway webhook
GCASH_WEBHOOK_SECRET=change-this-gcash-secret
